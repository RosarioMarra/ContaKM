<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ContaKM"
            android:textColor="#38bdf8" android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/w_bike" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="end" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <TextView android:id="@+id/w_live" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/widget_button" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="#062033" android:textStyle="bold" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/w_week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
            android:textColor="#ffffff" android:textStyle="bold" android:textSize="34sp" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp" android:text="km questa settimana" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_goal_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ProgressBar android:id="@+id/w_goal_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="7dp"
            android:max="100" android:progressDrawable="@drawable/widget_progress" />
        <TextView android:id="@+id/w_goal_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km mese" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km totali" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_rides" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="uscite" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_last" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#9fb0c4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
